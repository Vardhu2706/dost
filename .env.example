# Copy to .env.local and fill in. Never commit real values.

# ---- Sarvam ----------------------------------------------------------------
# API key for Sarvam speech-to-text, text-to-speech and chat. Required.
SARVAM_API_KEY=
# Sarvam chat model used for replies, the per-turn analyzer and the post-call summary.
LLM_MODEL=sarvam-105b

# ---- Server ----------------------------------------------------------------
# Random secret. Used as the HMAC key for caller identity, the browser URL token and the
# /call-me secret. Generate one: python -c "import secrets;print(secrets.token_hex(32))"
SERVER_SECRET=
# SQLite file that holds call memory (summary and open loop per caller).
DB_PATH=dost.db

# ---- Language and voices ---------------------------------------------------
# Language a call starts in before the caller's language is known: hi-IN, en-IN or te-IN.
DEFAULT_LANG=hi-IN
# Bulbul v4 Flash speaker IDs, one per language.
VOICE_HI=amit_hi_conversational
VOICE_EN=sunny_en_social
VOICE_TE=tarun_te_narration

# ---- Call behavior --------------------------------------------------------
# Days a leftover transcript is kept before it is purged (the purge runs at server start).
TRANSCRIPT_TTL_DAYS=7
# Minutes into a call after which Dost starts gently winding the conversation down.
SOFT_WIND_DOWN_MIN=15

# ---- Twilio phone leg (optional: leave empty for browser-only use) ---------
# Twilio account credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number callers dial, and the number Dost rings from in callback mode (E.164).
TWILIO_NUMBER=
# Public https URL of the tunnel that reaches this server, no trailing slash.
# Changes every time the tunnel restarts.
PUBLIC_BASE_URL=
# Verified mobile (E.164) that POST /call-me and scripts/call_me.py ring.
CALLBACK_NUMBER=
